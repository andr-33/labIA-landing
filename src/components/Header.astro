---
const { subtitle } = Astro.props;
---

<header class="w-full flex justify-between items-center py-4 px-6">
  <div class="flex items-center">
    <p class="text-3xl font-bold">
      <i class="fa fa-forumbee"></i> 
      <a href="/">Lab<span class="text-aquamarine">IA</span></a>
      {subtitle && (
        <span class="text-2xl">- {subtitle}</span>
      )} 
    </p>
  </div>
  <slot></slot>
</header>

<style>
  .text-aquamarine {
    color: aquamarine;
  }
</style>
